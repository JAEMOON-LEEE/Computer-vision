# 이 파일을 .env로 복사해 값을 채운다. .env는 git에 올리지 않는다.

# Caddy가 인증서를 받을 주소. 공인 IP가 158.180.1.2라면 158-180-1-2.sslip.io
SITE_ADDRESS=
# 위 주소에 https:// 를 붙인 값 (로그인 쿠키·출처 확인에 쓴다)
PUBLIC_BASE_URL=

DEPLOYMENT_MODE=cloud
TEAM_ACCESS_TOKEN=
ITS_API_KEY=
STREAM_PROXY=1

DATABASE_URL=
DATABASE_SCHEMA=twinsight
DATABASE_AUTO_CREATE=false
DATABASE_POOL_SIZE=2
DATABASE_MAX_OVERFLOW=1
DATABASE_APP_NAME=twinsight-vm

# 선택: CARTO 지도 키 (빌드 때 화면에 들어감)
VITE_CARTO_KEY=
