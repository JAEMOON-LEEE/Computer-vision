# Copy values into the backend's existing .env, not into frontend source.
# Supabase Connect > Session pooler. Use its real host and username.
# URL-encode reserved characters in the DB password; require encrypted transport.
DATABASE_URL=postgresql+psycopg://LOGIN.PROJECT_REF:ENCODED_PASSWORD@SESSION_POOLER_HOST:5432/postgres?sslmode=require
DATABASE_SCHEMA=twinsight
# Runtime accounts must not create/alter tables. Apply reviewed SQL as an owner first.
DATABASE_AUTO_CREATE=false
ITS_API_KEY=
STREAM_TTL_MINUTES=30
