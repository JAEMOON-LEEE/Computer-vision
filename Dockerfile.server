FROM python:3.14-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
COPY backend/requirements.txt /app/backend/requirements.txt
RUN pip install --no-cache-dir -r backend/requirements.txt
RUN useradd --create-home --uid 10001 twinsight
COPY --chown=twinsight:twinsight backend/app /app/backend/app
COPY --chown=twinsight:twinsight backend/__init__.py /app/backend/__init__.py
COPY --chown=twinsight:twinsight frontend /app/frontend
RUN mkdir -p /app/backend/data && chown twinsight:twinsight /app/backend/data
USER twinsight
EXPOSE 8000
CMD ["python", "-m", "uvicorn", "backend.app.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
